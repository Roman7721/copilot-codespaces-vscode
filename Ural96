styles.css
/* Общие настройки */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Arial', sans-serif;
    line-height: 1.6;
    color: #fff;
    background-color: #000;
}

.container {
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
}

/* Главная секция */
.hero {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    background-color: #000;
    text-align: center;
}

.content {
    text-transform: uppercase;
}

.content h1 {
    font-size: 5em;
    letter-spacing: 5px;
    font-weight: bold;
    margin-bottom: 20px;
}

.content p {
    font-size: 1.2em;
    opacity: 0.8;
}

/* О нас */
.about {
    background-color: #111;
    padding: 40px 0;
    text-align: center;
}

.about h2 {
    font-size: 2em;
    margin-bottom: 20px;
}

.about p {
    font-size: 1.2em;
    opacity: 0.9;
}

/* Контакты */
.footer {
    background-color: #000;
    padding: 40px 0;
    text-align: center;
}

.footer h2 {
    font-size: 2em;
    margin-bottom: 20px;
}

.footer p {
    font-size: 1.2em;
    opacity: 0.8;
    margin: 10px 0;
}
